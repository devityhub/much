PORT=3001
# Troque por uma string longa e aleatoria em producao
JWT_SECRET=troque-isto-por-um-segredo-grande

# Opcional: caminho do banco SQLite (padrao: ./data/streamflix.db)
# DB_PATH=./data/streamflix.db

# Origens permitidas para CORS, separadas por virgula (padrao: qualquer origem)
# CORS_ORIGIN=https://streamflix.seudominio.com

MAX_PEERS_PER_ROOM=6

# STUN/TURN. Sem TURN, pessoas atras de NAT restritivo podem nao conectar.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.seudominio.com:3478?transport=udp,turn:turn.seudominio.com:3478?transport=tcp
# TURN_USERNAME=streamflix
# TURN_CREDENTIAL=senha-do-turn

# HTTPS opcional. Camera, microfone e tela so funcionam em HTTPS (ou localhost).
# SSL_KEY_PATH=./certs/key.pem
# SSL_CERT_PATH=./certs/cert.pem

# Spotify — quem hospeda o PassTime preenche uma vez (usuários só clicam em Conectar).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Opcional: por padrão o callback usa o endereço por onde o PassTime foi aberto.
# SPOTIFY_REDIRECT_URI=https://seudominio.com/api/spotify/callback
